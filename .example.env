# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=biblioteca

# String de conexão do Prisma (usada pela aplicação)
# Se for rodar localmente, use 'localhost'. Se for rodar com Docker, use 'db'.
DATABASE_URL="postgresql://postgres:sua_senha_aqui@localhost:5432/biblioteca?schema=public"

# Configurações da Aplicação
PORT=3000
NODE_ENV=development

# Nível de Log (info, debug, error)
LOG_LEVEL=info